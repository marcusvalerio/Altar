{
  "name": "altar",
  "version": "1.0.0",
  "private": true,
  "description": "ALTAR — Devocional Espírita. MVP de leitura devocional diária.",
  "scripts": {
    "content:import": "node scripts/content/import.mjs",
    "content:validate": "node scripts/content/validate.mjs",
    "predev": "npm run content:import && npm run content:validate -- --warn-only",
    "dev": "next dev",
    "prebuild": "npm run content:import && npm run content:validate",
    "build": "next build",
    "postbuild": "node scripts/generate-sw.mjs",
    "start": "npx http-server out -p 3000 -c-1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
