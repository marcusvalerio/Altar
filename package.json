{
  "name": "altar",
  "version": "1.0.0",
  "private": true,
  "description": "ALTAR — Devocional Espírita. MVP de leitura devocional diária.",
  "scripts": {
    "content:import": "node scripts/content/import.mjs",
    "content:validate": "node scripts/content/validate.mjs",
    "content:sql": "node scripts/content/neon-sql.mjs",
    "predev": "npm run content:import && npm run content:validate -- --warn-only",
    "dev": "next dev",
    "prebuild": "npm run content:import && npm run content:validate && node scripts/generate-sw.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:schema": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f db/schema.sql"
  },
  "dependencies": {
    "next": "^16.3.8",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
